# QuantFlow 生产环境配置
# 复制此文件为 .env 并填入真实值

# ==================== 必填 ====================

# JWT 密钥 (用 openssl rand -hex 32 生成)
JWT_SECRET=

# 数据库密码 (用 openssl rand -hex 16 生成)
POSTGRES_PASSWORD=

# 币安 API
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# LLM API Keys
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# ==================== 可选 ====================

# 数据库
POSTGRES_USER=quantflow
POSTGRES_DB=quantflow

# 域名
DOMAIN=localhost

# MT Bridge
BRIDGE_PORT=9090
